# Optional for `npm run dev` when using Vite proxy to /api (default).
# If Fastify uses another port, set when starting Vite:
# HOLIDAYS_API_PROXY_TARGET=http://127.0.0.1:4011
#
# Required for `npm run build` + `vite preview` — point at your running `server/`:
# VITE_HOLIDAYS_API_URL=http://127.0.0.1:4010
